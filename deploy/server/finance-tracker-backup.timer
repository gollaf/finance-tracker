# Starts finance-tracker-backup.service every night.

[Unit]
Description=Back up the finance-tracker database daily

[Timer]
OnCalendar=*-*-* 03:00:00 UTC
# Spreads the start over 15 minutes instead of exactly on the hour.
RandomizedDelaySec=15min
# A run missed while the server was off happens as soon as it is back.
Persistent=true

[Install]
WantedBy=timers.target
