# Template for the .env file next to compose.yaml on the server. The real .env
# holds passwords: it exists only on the server, never in the repository.
# Format: KEY=value, no quotes, no spaces around "=".

# Which build to run: "sha-" plus the first 7 characters of a master commit.
# Never "latest": it changes under you, and you can't tell what is running.
IMAGE_TAG=sha-xxxxxxx

# Generate each with `openssl rand -hex 24`. Hex only, because the password is
# placed inside a connection string, where a ";" would end it early.
# Both are applied only the first time, to empty data volumes.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=

# The public name of the server, e.g. yourname.duckdns.org. It must already
# point to the server's public IP: Caddy proves to Let's Encrypt that it
# controls this name before it gets the certificate.
PUBLIC_HOST=

# Optional: a Groq API key for the AI features. Left empty, they fall back.
GROQ_API_KEY=
