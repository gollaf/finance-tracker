# Template for deploy/k8s/secrets.env, which kustomization.yaml turns into the
# Kubernetes Secret "finance-tracker-secrets". Copy this file to secrets.env
# (gitignored -- it must never be committed) and fill in the values:
#
#   Copy-Item deploy/k8s/secrets.env.example deploy/k8s/secrets.env
#
# Format: one KEY=value per line, exactly as written. No quotes -- Kustomize
# keeps them as part of the value -- and no spaces around the "=". Lines
# starting with # are comments. Windows line endings are fine.
#
# Local cluster only: these guard a database on your own machine, same as the
# plaintext credentials in docker-compose.yml (ADR 0008). What changes here is
# the mechanism -- values live outside git and reach containers through a
# Secret -- which is the one a real deployment needs.

# Password of the "postgres" superuser. Only read the FIRST time Postgres
# starts with an empty data volume: changing it here later does not change the
# password of an existing database (same as the compose volume).
POSTGRES_PASSWORD=change-me
