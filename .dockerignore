# Build output: the image builds fresh, and host binaries must not slip in.
**/bin/
**/obj/

# IDE / editor state
**/.vs/
**/.idea/
.vscode/

# Version control
.git/
.gitignore
.gitattributes

# Not needed to build the images.
tests/
docs/
# Includes the gitignored deploy/k8s/secrets.env, which must never reach an image.
deploy/
*.md
.github/
.editorconfig
.config/
